{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Excerpt Studio",
  "version": "0.1.1",
  "identifier": "com.huo.excerpt-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "书摘 · Excerpt Studio",
        "width": 1280,
        "height": 1000,
        "minWidth": 1080,
        "minHeight": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "GraphicsAndDesign",
    "copyright": "Copyright 2026 Huo",
    "shortDescription": "书摘分享卡片生成器",
    "longDescription": "本地离线的书摘分享卡片生成器，微信读书风格，一键导出高清 PNG。",
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
